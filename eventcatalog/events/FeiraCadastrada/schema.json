{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FeiraCadastrada",
  "description": "Uma ONG cadastrou uma feira de adoção. Confirma o cadastro por e-mail para a ONG.",
  "type": "object",
  "required": [
    "id",
    "nome",
    "ocorridoEm",
    "dados"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único da mensagem (gerado na publicação)."
    },
    "nome": {
      "const": "FeiraCadastrada",
      "description": "Nome do evento; também é a chave de roteamento no RabbitMQ."
    },
    "ocorridoEm": {
      "type": "string",
      "format": "date-time",
      "description": "Momento em que o evento foi publicado (UTC)."
    },
    "dados": {
      "type": "object",
      "required": [
        "feiraId",
        "nome",
        "endereco",
        "dataInicio",
        "dataFim",
        "idOng"
      ],
      "additionalProperties": false,
      "properties": {
        "feiraId": {
          "type": "string",
          "description": "Id da feira (UUID).",
          "format": "uuid"
        },
        "nome": {
          "type": "string",
          "description": "Nome da feira."
        },
        "endereco": {
          "type": "string",
          "description": "Endereço informado."
        },
        "dataInicio": {
          "type": "string",
          "description": "Início (ISO 8601).",
          "format": "date-time"
        },
        "dataFim": {
          "type": "string",
          "description": "Fim (ISO 8601).",
          "format": "date-time"
        },
        "idOng": {
          "type": "string",
          "description": "Id da ONG dona da feira."
        },
        "ongNome": {
          "type": "string",
          "description": "Nome da ONG (ausente se o serviço de usuários estava fora do ar)."
        },
        "destinatarioEmail": {
          "type": "string",
          "description": "E-mail da ONG (ausente se o serviço de usuários estava fora do ar).",
          "format": "email"
        }
      }
    }
  }
}
